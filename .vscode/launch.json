// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            // O nome que vai aparecer no menu do VS Code
            "name": "Portal Unifast (Debug)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            // Aqui está a mágica: os argumentos que você usava no terminal
            "args": [
                "--flavor",
                "unifast",
                "--dart-define=FLAVOR=unifast"
            ]
        },
        {
            // Exemplo para um segundo flavor
            "name": "Dra Jéssica (Debug)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "drajessica",
                "--dart-define=FLAVOR=drajessica"
            ]
        }
        // Você pode adicionar mais configurações para "profile" ou "release" aqui
    ]
}